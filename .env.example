# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres connection string (use the "Connection string (URI)" format).
DATABASE_URL=

# ── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Authorization ─────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed to access the app.
# Empty = OPEN registration (any authenticated Google account can sign in).
# Set it to a non-empty allowlist in production to restrict access.
ALLOWED_EMAILS=
